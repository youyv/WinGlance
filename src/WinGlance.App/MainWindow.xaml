<Window x:Class="WinGlance.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinGlance.App.Controls">
  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <Grid Padding="10,20,10,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="22">
          <Border Background="#238E82" Width="40" Height="40" CornerRadius="12"><FontIcon Glyph="&#xE9D9;" Foreground="White" FontSize="22" /></Border>
          <Grid Width="46" Height="46">
            <Button x:Name="OverviewButton" AutomationProperties.Name="资源概览" AutomationProperties.HelpText="当前页面" Width="46" Height="46" ToolTipService.ToolTip="资源概览" Click="Overview_Click"><FontIcon Glyph="&#xE9D9;" FontSize="20" /></Button>
            <Border x:Name="OverviewMarker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" Background="{StaticResource GlanceAccent}" IsHitTestVisible="False" />
          </Grid>
          <Grid Width="46" Height="46" Margin="0,-12,0,0">
            <Button x:Name="StatisticsButton" AutomationProperties.Name="运行统计" Width="46" Height="46" ToolTipService.ToolTip="运行统计" Click="Statistics_Click"><FontIcon Glyph="&#xE9D2;" FontSize="20" /></Button>
            <Border x:Name="StatisticsMarker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" Background="{StaticResource GlanceAccent}" IsHitTestVisible="False" Visibility="Collapsed" />
          </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="10">
          <Button x:Name="OverlayButton" AutomationProperties.Name="桌面悬浮条" Width="46" Height="42" Click="Overlay_Click" ToolTipService.ToolTip="桌面悬浮条"><FontIcon Glyph="&#xE8A7;" FontSize="18" /></Button>
          <Button AutomationProperties.Name="设置" Width="46" Height="42" Click="Settings_Click" ToolTipService.ToolTip="设置"><FontIcon Glyph="&#xE713;" FontSize="18" /></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="OverviewContent" Grid.Column="1" Padding="28,20,28,16" RowSpacing="20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel Spacing="4"><TextBlock Text="资源概览" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="看清每个应用，让资源使用一目了然。" Style="{StaticResource Muted}" /></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="12,6"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Fill="#35B59F" Width="7" Height="7"/><TextBlock x:Name="LiveLabel" Text="正在连接" FontSize="12" /></StackPanel></Border>
          <Button x:Name="PauseButton" Content="暂停显示" Click="Pause_Click" />
          <Button x:Name="EnhancedButton" Content="增强采集" Click="Elevate_Click" ToolTipService.ToolTip="提升当前账户的采集器权限，启用进程网络与磁盘事件采集" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="5"><TextBlock Text="CPU" Style="{StaticResource Muted}"/><TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource Metric}"/><local:Sparkline x:Name="CpuChart" Height="28" Stroke="#38B7A4" FixedMaximum="100"/><TextBlock Text="整机处理器利用率" FontSize="11" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="5"><TextBlock Text="GPU" Style="{StaticResource Muted}"/><TextBlock x:Name="GpuValue" Text="—" Style="{StaticResource Metric}"/><local:Sparkline x:Name="GpuChart" Height="28" Stroke="#8B83DC" FixedMaximum="100"/><TextBlock x:Name="GpuHint" Text="最忙引擎" FontSize="11" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel Spacing="5"><TextBlock Text="内存" Style="{StaticResource Muted}"/><TextBlock x:Name="MemoryValue" Text="—" Style="{StaticResource Metric}"/><ProgressBar x:Name="MemoryBar" Maximum="100" Height="4" Margin="0,12,0,12" Foreground="#D7A45B"/><TextBlock x:Name="MemoryHint" Text="物理内存" FontSize="11" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel Spacing="5">
          <Button x:Name="NetworkDeviceButton" AutomationProperties.Name="网络" Click="NetworkDevice_Click" Padding="0" MinHeight="20" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" ToolTipService.ToolTip="选择实时概览网卡；运行统计仍累计整机物理网卡">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="网络" VerticalAlignment="Center"/>
              <FontIcon Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="NetworkValue" Text="—" FontSize="25" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="UploadValue" Text="↑ —" FontSize="14" Margin="0,4,0,4"/><TextBlock x:Name="NetworkHint" Text="活动网卡" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel Spacing="5">
          <Button x:Name="DiskDeviceButton" AutomationProperties.Name="磁盘" Click="DiskDevice_Click" Padding="0" MinHeight="20" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" ToolTipService.ToolTip="选择实时概览磁盘；运行统计仍累计全部物理磁盘">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="磁盘" VerticalAlignment="Center"/>
              <FontIcon Glyph="&#xE70D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="DiskValue" Text="—" FontSize="25" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="DiskWriteValue" Text="写 —" FontSize="14" Margin="0,4,0,4"/><TextBlock x:Name="DiskHint" Text="磁盘读写吞吐" FontSize="11" Style="{StaticResource Muted}"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="2" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBox x:Name="SearchBox" PlaceholderText="搜索软件、进程、PID 或路径" Width="340" HorizontalAlignment="Left" TextChanged="Search_Changed"/><ToggleSwitch x:Name="HideSystemToggle" Header="" OnContent="隐藏 Windows 系统进程" OffContent="显示 Windows 系统进程" IsOn="True" HorizontalAlignment="Right" Toggled="HideSystem_Toggled"/></Grid>
        <Grid Grid.Row="1"><StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Name="AllFilter" Content="全部应用" IsChecked="True" Click="Filter_Click" Tag="all"/><ToggleButton x:Name="NetworkFilter" Content="正在联网" Click="Filter_Click" Tag="network"/><ToggleButton x:Name="GpuFilter" Content="使用 GPU" Click="Filter_Click" Tag="gpu"/><TextBlock x:Name="CountLabel" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Muted}" FontSize="12"/></StackPanel><TextBlock x:Name="SortHint" Text="点击列标题排序 · 点击应用查看趋势" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Muted}"/></Grid>
      </Grid>
      <Border Grid.Row="3" Style="{StaticResource Card}" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" Padding="0" CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Padding="18,0,22,0" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="210"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="95"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <Button x:Name="NameHeader" Content="应用" Tag="name" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"/>
            <Button Grid.Column="1" Content="CPU ↓" x:Name="CpuHeader" Tag="cpu" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/>
            <Button Grid.Column="2" x:Name="GpuHeader" Content="GPU" Tag="gpu" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/>
            <Button Grid.Column="3" x:Name="MemoryHeader" Content="内存" Tag="memory" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/>
            <Button Grid.Column="4" x:Name="DownloadHeader" Content="下载" Tag="down" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/>
            <Button Grid.Column="5" x:Name="UploadHeader" Content="上传" Tag="up" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/>
            <Button Grid.Column="6" x:Name="DiskHeader" Content="磁盘 I/O" Tag="disk" Click="Sort_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/>
          </Grid>
          <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Process_ItemClick" HorizontalContentAlignment="Stretch" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="60"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="12,9,16,9" ColumnSpacing="16" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="8" RightTapped="Row_RightTapped" ToolTipService.ToolTip="{Binding Tooltip}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="210"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="95"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                  <Grid Margin="{Binding Indent}"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{Binding ExpandGlyph}" Tag="{Binding Key}" Click="Expand_Click" Visibility="{Binding ExpandVisibility}" Width="24" Height="28" Padding="0" Background="Transparent" BorderThickness="0" FontSize="11"/><Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"><Grid><FontIcon Glyph="&#xE737;" FontSize="17" Opacity="0.45"/><Image Source="{Binding Icon}" Width="28" Height="28"/></Grid></Border><StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock Text="{Binding Cpu}" Style="{StaticResource Number}"/><ProgressBar Value="{Binding CpuValue}" Maximum="100" Height="3" Foreground="{Binding CpuBrush}"/></StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5"><TextBlock Text="{Binding Gpu}" Style="{StaticResource Number}"/><ProgressBar Value="{Binding GpuValue}" Maximum="100" Height="3" Foreground="{Binding GpuBrush}"/></StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding Memory}" Style="{StaticResource Number}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding Download}" Style="{StaticResource Number}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding Upload}" Style="{StaticResource Number}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="6" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding DiskRead}" Style="{StaticResource Number}"/><TextBlock Text="{Binding DiskWrite}" Style="{StaticResource Number}" Opacity="0.6" FontSize="11"/></StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xE9D9;" FontSize="36" Opacity="0.35"/><TextBlock x:Name="EmptyLabel" Text="等待第一份采集数据…" Style="{StaticResource Muted}"/></StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Row="4" Spacing="8">
        <InfoBar x:Name="OverlayNotice" Title="悬浮条提示" IsOpen="False" IsClosable="True" Severity="Warning"/>
        <InfoBar x:Name="CollectionNotice" Title="采集提示" IsOpen="False" IsClosable="True" Severity="Warning" CloseButtonClick="CollectionNotice_CloseButtonClick"/>
        <Grid><TextBlock x:Name="StatusLabel" Text="正在启动采集器…" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,150,0"/><Button x:Name="ReconnectButton" Content="恢复普通采集" Click="Reconnect_Click" HorizontalAlignment="Right" FontSize="11" Padding="8,2" ToolTipService.ToolTip="重新连接普通采集器；增强采集请使用顶部按钮"/></Grid>
      </StackPanel>
    </Grid>
    <ContentControl x:Name="StatisticsHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
    <Border x:Name="DetailPanel" Grid.Column="1" HorizontalAlignment="Right" Width="370" Margin="0,0,0,0" Padding="24" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
      <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="18">
        <Grid><TextBlock Text="应用详情" FontSize="14" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="CloseDetailButton" Content="✕" AutomationProperties.Name="关闭应用详情" Click="CloseDetail_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"/></Grid>
        <StackPanel Orientation="Horizontal" Spacing="14"><Image x:Name="DetailIcon" Width="48" Height="48"/><StackPanel VerticalAlignment="Center" Width="240"><TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailSubtitle" FontSize="12" Style="{StaticResource Muted}"/></StackPanel></StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="CPU · 最近 60 秒" FontSize="12" Style="{StaticResource Muted}"/><TextBlock x:Name="DetailCpu" FontSize="26" FontWeight="SemiBold"/><local:Sparkline x:Name="DetailCpuChart" Height="70" Stroke="#38B7A4" FixedMaximum="100"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="GPU · 最忙引擎" FontSize="12" Style="{StaticResource Muted}"/><TextBlock x:Name="DetailGpu" FontSize="26" FontWeight="SemiBold"/><local:Sparkline x:Name="DetailGpuChart" Height="55" Stroke="#8B83DC" FixedMaximum="100"/><TextBlock x:Name="DetailVram" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="网络 · 最近 60 秒" FontSize="12" Style="{StaticResource Muted}"/><TextBlock x:Name="DetailNetwork" FontSize="15"/><local:Sparkline x:Name="DetailDownloadChart" Height="50" Stroke="#38B7A4"/><local:Sparkline x:Name="DetailUploadChart" Height="35" Stroke="#D7A45B"/><TextBlock Text="青色：下载  ·  金色：上传（独立纵轴）" FontSize="11" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="当前网络连接" FontWeight="SemiBold"/>
            <TextBlock x:Name="ConnectionHint" Text="展开详情时按需查询" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ConnectionProtocol" Header="协议" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ConnectionFilter_Changed">
                <ComboBoxItem Content="全部"/><ComboBoxItem Content="TCP"/><ComboBoxItem Content="UDP"/>
              </ComboBox>
              <ComboBox x:Name="ConnectionState" Grid.Column="1" Header="状态" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ConnectionFilter_Changed">
                <ComboBoxItem Content="全部"/><ComboBoxItem Content="已连接"/><ComboBoxItem Content="监听"/><ComboBoxItem Content="其他 TCP"/><ComboBoxItem Content="UDP 绑定"/>
              </ComboBox>
            </Grid>
            <TextBlock x:Name="ConnectionFilterHint" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
            <ListView x:Name="ConnectionsList" MaxHeight="240" SelectionMode="None" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="3" Background="Transparent" ContextRequested="Connection_ContextRequested" RightTapped="Connection_RightTapped">
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Protocol}" IsTextSelectionEnabled="False" FontSize="11" Foreground="{StaticResource GlanceAccent}"/><TextBlock Text="{Binding State}" IsTextSelectionEnabled="False" FontSize="11"/><TextBlock Text="{Binding Process.Pid}" IsTextSelectionEnabled="False" FontSize="11" Style="{StaticResource Muted}"/></StackPanel>
                <TextBlock IsTextSelectionEnabled="False" Text="{Binding LocalEndpoint}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock IsTextSelectionEnabled="False" Text="{Binding RemoteEndpoint}" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
              </StackPanel></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="ConnectionEmpty" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
            <TextBlock x:Name="ConnectionCopyNotice" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
            <TextBlock Text="每 3 秒更新 · 本地端点在上，远端在下&#x0a;UDP 仅显示本地绑定；监听端口没有远端。" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
          </StackPanel>
        </Border>
        <StackPanel Spacing="6"><TextBlock Text="文件路径" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="DetailPath" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}"/></StackPanel>
        <TextBlock x:Name="DetailClassification" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
        <TextBlock x:Name="DetailProcesses" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <Button Content="打开文件所在位置" Click="OpenLocation_Click" HorizontalAlignment="Stretch"/>
        <TextBlock Text="显存为进程记账合计，可能包含重复的共享映射。网络为应用发送/接收速率，可能与顶部网卡统计不同。" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
      </StackPanel></ScrollViewer>
    </Border>
  </Grid>
</Window>
